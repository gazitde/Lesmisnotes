# Build-time only. Leave unset for a noindex preview.
SITE_ORIGIN=
PUBLIC_SITE=false

# Server-only contact settings. Never prefix with PUBLIC_ or put these in dist/.
# Configure through the hosting provider's secure environment settings.
CONTACT_ENABLED=false
CONTACT_RECIPIENT=
CONTACT_FROM=
RESEND_API_KEY=
CONTACT_SIGNING_SECRET=
CONTACT_ALLOWED_ORIGINS=
CONTACT_RATE_LIMIT_MODE=memory
# Optional shared abuse controls, only after authorized setup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
