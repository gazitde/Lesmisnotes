# Build-time only. Verified HTTPS destination; indexing remains independently disabled.
# Leave SITE_ORIGIN unset when an unconfigured preview should omit canonicals.
SITE_ORIGIN=https://www.lesmisnotes.com
PUBLIC_SITE=false

# Server-only contact settings. Never prefix with PUBLIC_ or put these in dist/.
# Configure through the hosting provider's secure environment settings.
CONTACT_ENABLED=false
CONTACT_PROVIDER=formsubmit
# The existing public FormSubmit routing alias is kept in server/contact-route.cjs.
# Optional override: FORMSUBMIT_ALIAS=
# Resend settings below are needed only with CONTACT_PROVIDER=resend.
CONTACT_RECIPIENT=
CONTACT_FROM=
RESEND_API_KEY=
CONTACT_SIGNING_SECRET=
CONTACT_ALLOWED_ORIGINS=
CONTACT_RATE_LIMIT_MODE=memory
# Optional shared abuse controls, only after authorized setup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
