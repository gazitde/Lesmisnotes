{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public-dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), microphone=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:lang(he|en)/character-:id/",
      "has": [
        {
          "type": "query",
          "key": "reader"
        }
      ],
      "destination": "/profile-readers/:lang/:id.html"
    },
    {
      "source": "/:lang(he|en)/novel-journey/",
      "has": [
        {
          "type": "query",
          "key": "focus"
        }
      ],
      "destination": "/reading-shells/:lang.html"
    },
    {
      "source": "/:lang(he|en)/novel-journey/",
      "missing": [
        {
          "type": "query",
          "key": "focus"
        }
      ],
      "destination": "/route-pages/:lang/novel-journey.html"
    },
    {
      "source": "/:lang(he|en)/novel/",
      "has": [
        {
          "type": "query",
          "key": "focus"
        }
      ],
      "destination": "/reading-shells/:lang.html"
    },
    {
      "source": "/:lang(he|en)/novel/",
      "missing": [
        {
          "type": "query",
          "key": "focus"
        }
      ],
      "destination": "/route-pages/:lang/novel.html"
    },
    {
      "source": "/:lang(he|en)/character-:id/",
      "missing": [
        {
          "type": "query",
          "key": "reader"
        }
      ],
      "destination": "/route-pages/:lang/character-:id.html"
    }
  ],
  "redirects": [
    {
      "source": "/:lang(en|he)",
      "destination": "/:lang/home/",
      "permanent": true
    },
    {
      "source": "/:lang(en|he)/",
      "destination": "/:lang/home/",
      "permanent": true
    },
    {
      "source": "/he/tribute",
      "destination": "/he/listening/?category=together",
      "permanent": true
    },
    {
      "source": "/he/tribute/",
      "destination": "/he/listening/?category=together",
      "permanent": true
    },
    {
      "source": "/he/humor",
      "destination": "/he/listening/?category=humor",
      "permanent": true
    },
    {
      "source": "/he/humor/",
      "destination": "/he/listening/?category=humor",
      "permanent": true
    },
    {
      "source": "/en/tribute",
      "destination": "/en/listening/?category=together",
      "permanent": true
    },
    {
      "source": "/en/tribute/",
      "destination": "/en/listening/?category=together",
      "permanent": true
    },
    {
      "source": "/en/humor",
      "destination": "/en/listening/?category=humor",
      "permanent": true
    },
    {
      "source": "/en/humor/",
      "destination": "/en/listening/?category=humor",
      "permanent": true
    }
  ]
}
